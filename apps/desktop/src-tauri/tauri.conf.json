{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Arca for Agents",
  "version": "0.8.0",
  "identifier": "com.mastrien.arca4agents",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Arca4agents",
        "width": 1200,
        "height": 780,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE0OEQzOEVGNDI1MDk1RkMKUldUOGxWQkM3emlORkFqcDZVcm8wbENjTWp1NnJEMWxtNklxR1l6NVpNS1k2TGFvRjZWYmEwVUsK",
      "endpoints": [
        "https://github.com/mastrien/arca4agents/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
